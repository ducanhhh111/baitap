@model AspNetCoreViewLab_NET8_FULL_VN.Models.Book
@{ ViewData["Title"] = "Chi tiết sách"; }
<h2>@Model.Title</h2>
<div class="row">
  <div class="col-md-4"><img src="@Model.Image" class="img-fluid" alt="@Model.Title" /></div>
  <div class="col-md-8">
    <p><strong>Giá:</strong> @String.Format("{0:N0}", Model.Price) VND</p>
    <p><strong>Số trang:</strong> @Model.TotalPage</p>
    <p><strong>Tóm tắt:</strong> @Model.Summary</p>
    <p><a class="btn btn-secondary" asp-action="Index">Quay lại</a></p>
  </div>
</div>
