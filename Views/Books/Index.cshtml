@model IEnumerable<AspNetCoreViewLab_NET8_FULL_VN.Models.Book>
@{ ViewData["Title"] = "Danh sách sách"; }

<h2>Danh sách các cuốn sách</h2>

<table class="table table-bordered align-middle">
  <thead>
    <tr>
      <th style="width:50px">Id</th>
      <th>Tiêu đề</th>
      <th>Tác giả (Id)</th>
      <th>Thể loại (Id)</th>
      <th>Giá</th>
      <th>Hình ảnh</th>
      <th style="width:140px">Thao tác</th>
    </tr>
  </thead>
  <tbody>
  @foreach(var b in Model) {
    <tr>
      <td>@b.Id</td>
      <td>@b.Title</td>
      <td>@b.AuthorId</td>
      <td>@b.GenreId</td>
      <td>@String.Format("{0:N0}", b.Price) VND</td>
      <td><img src="@b.Image" alt="@b.Title" style="max-width:60px" /></td>
      <td>
        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@b.Id">Sửa</a>
        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@b.Id">Xóa</a>
      </td>
    </tr>
  }
  </tbody>
</table>
